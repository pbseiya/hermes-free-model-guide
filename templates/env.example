# Environment Variables Template
# ===============================
# Copy this file to ~/.hermes/.env and fill in your keys
# DO NOT commit this file to Git!

# =============================================================================
# OKMD AI Playground (Free — Recommended)
# =============================================================================
# Get your key at: https://playground.okmd.or.th
# Settings → API Platform → Generate Key
OKMD_API_KEY=YOUR_OKMD_API_KEY_HERE

# SSL workaround for OKMD (self-signed certificate)
NODE_TLS_REJECT_UNAUTHORIZED=0

# =============================================================================
# OpenRouter (27+ free models)
# =============================================================================
# Get your key at: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

# =============================================================================
# Google AI Studio (free tier)
# =============================================================================
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIzaYOUR_KEY_HERE

# =============================================================================
# Groq (fast inference)
# =============================================================================
# Get your key at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_YOUR_KEY_HERE

# =============================================================================
# Telegram Bot
# =============================================================================
# Create bot via @BotFather in Telegram
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHI...
# TELEGRAM_ALLOWED_USERS=your_telegram_user_id
